NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `npx supabase status`>
APP_URL=http://localhost:3000
# At least 32 random characters; signs agent-to-agent tokens
A2A_SIGNING_SECRET=
# Rate limiting anonymous callers by address: only when the address can be trusted (see lib/a2a/client-ip.ts).
# Set ONE of these to match your hosting; leave both empty and all anonymous callers of an agent share one allowance.
#   TRUSTED_IP_HEADER: a header your host sets and callers can't forge (cf-connecting-ip, x-vercel-forwarded-for, ...)
#   TRUSTED_PROXY_HOPS: how many proxies you run in front of the app (1 for a single reverse proxy)
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=
# anthropic | mock  (mock = deterministic, no API key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: "Find people you know" from email contacts (read-only, one-time sync).
# Google Cloud: OAuth client (Web), People API enabled, redirect URI ${APP_URL}/api/contacts/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app (personal + work accounts), delegated Contacts.Read, redirect URI ${APP_URL}/api/contacts/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Without keys, development simulates both with the demo accounts (CONTACTS_PROVIDER=dev). Same for SMS codes (SMS_PROVIDER=dev).
