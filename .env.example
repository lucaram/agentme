NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `npx supabase status`>
APP_URL=http://localhost:3000
# At least 32 random characters; signs agent-to-agent tokens
A2A_SIGNING_SECRET=
# anthropic | mock  (mock = deterministic, no API key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
